---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { 
  title = 'VoidStack | Engineering & Exploration',
  description = 'VoidStack — Breaking abstractions. Understanding systems.',
  image = '/og-image.png',
  canonical = Astro.url.pathname
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const fullUrl = new URL(canonical, siteUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="google-site-verification" content="Tr6kqeBjE4kzwL4g61f89I5DpbxcZ3tmas3p5qYvYXU" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl).toString()} />
    
    <!-- Canonical -->
    <link rel="canonical" href={fullUrl} />
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      const key = 'voidstack-theme';
      const button = document.querySelector('#theme-toggle');
      const saved = localStorage.getItem(key);
      if (saved === 'light') document.body.classList.add('light-theme');
      const updateButton = () => {
        if (button) {
          button.textContent = document.body.classList.contains('light-theme') ? '☾' : '☼';
          button.setAttribute('aria-label', document.body.classList.contains('light-theme') ? 'Switch to dark theme' : 'Switch to light theme');
        }
      };
      updateButton();
      button?.addEventListener('click', () => {
        document.body.classList.toggle('light-theme');
        localStorage.setItem(key, document.body.classList.contains('light-theme') ? 'light' : 'dark');
        updateButton();
      });
    </script>
  </body>
</html>
