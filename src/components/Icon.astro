        | "calendar"
        | "book"
        | "hash"
        | "search"
        | "palette"
        | "sun"
        | "moon"
        | "github"
        | "mail"
        | "home"
        | "chevron-left"
        | "chevron-right"
        | "rss"
        | "close"
        | "clock"
        | "file-text"
        | "linkedin";
