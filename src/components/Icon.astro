        '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2a10 10 0 1 0 10 10c0-1-1-2-2-2h-2.5a2 2 0 0 1-2-2c0-.6.2-1 .5-1.4.3-.5.5-.9.5-1.6a2 2 0 0 0-2-2H12"/>',
