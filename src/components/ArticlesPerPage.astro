---
/**
 * ArticlesPerPage Component
 * Provides a segmented control for users to select articles per page.
 * Uses client-side JavaScript to dynamically paginate articles.
 */

const PAGE_SIZE_OPTIONS = [5, 10, 15] as const;
const DEFAULT_SIZE = 5;
---

<div class="articles-per-page-container">
  <label class="articles-per-page-label">Articles per page:</label>
  <div class="articles-per-page-control" role="radiogroup" aria-label="Articles per page">
    {
      PAGE_SIZE_OPTIONS.map((size) => (
        <button
          type="button"
          class="articles-per-page-btn"
          data-size={size}
          aria-pressed={false}
          title={`Display ${size} articles per page`}
        >
          {size}
        </button>
      ))
    }
  </div>
</div>

<script is:inline define:vars={{ DEFAULT_SIZE, PAGE_SIZE_OPTIONS }}>
  (function () {
    const getStoredPageSize = () => {
      try {
        const stored = localStorage.getItem('voidstack-articles-per-page');
        const size = stored ? parseInt(stored, 10) : DEFAULT_SIZE;
        return PAGE_SIZE_OPTIONS.includes(size) ? size : DEFAULT_SIZE;
      } catch {
        return DEFAULT_SIZE;
      }
    };

    const setStoredPageSize = (size) => {
      try {
        localStorage.setItem('voidstack-articles-per-page', size.toString());
        localStorage.setItem('voidstack-current-page', '1');
      } catch {}
    };

    const getStoredCurrentPage = () => {
      try {
        return parseInt(localStorage.getItem('voidstack-current-page') || '1', 10);
      } catch {
        return 1;
      }
    };

    const setStoredCurrentPage = (page) => {
      try {
        localStorage.setItem('voidstack-current-page', page.toString());
      } catch {}
    };

    // Apply article pagination
    function paginateArticles() {
      const pageSize = getStoredPageSize();
      const currentPage = getStoredCurrentPage();
      const articles = Array.from(document.querySelectorAll('.post-list .post-card'));
      
      if (articles.length === 0) return;

      const totalPages = Math.ceil(articles.length / pageSize);
      const validPage = Math.min(Math.max(currentPage, 1), totalPages);
      
      const startIndex = (validPage - 1) * pageSize;
      const endIndex = startIndex + pageSize;

      // Hide/show articles based on current page
      articles.forEach((article, index) => {
        const shouldShow = index >= startIndex && index < endIndex;
        article.style.display = shouldShow ? '' : 'none';
      });

      // Update pagination controls
      updatePaginationUI(validPage, totalPages);
    }

    function updatePaginationUI(currentPage, totalPages) {
      const pagination = document.querySelector('.pagination');
      if (!pagination) return;

      // Regenerate page number buttons
      const pageNumbersDiv = pagination.querySelector('.page-numbers');
      if (pageNumbersDiv) {
        // Clear existing buttons but preserve data-page attribute structure
        const existingBtns = Array.from(pageNumbersDiv.querySelectorAll('[data-page]'));
        existingBtns.forEach(btn => btn.remove());

        // Create new buttons for all pages
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'page-link' + (i === currentPage ? ' active' : '');
          btn.setAttribute('data-page', i.toString());
          btn.setAttribute('aria-current', i === currentPage ? 'page' : 'false');
          btn.textContent = i.toString();
          
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            setStoredCurrentPage(i);
            paginateArticles();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
          
          pageNumbersDiv.appendChild(btn);
        }
      }

      // Update prev/next buttons
      const prevBtn = pagination.querySelector('[data-pagination-action="prev"]');
      const nextBtn = pagination.querySelector('[data-pagination-action="next"]');
      
      if (prevBtn) {
        prevBtn.disabled = currentPage === 1;
        // Remove old listeners by cloning
        const newPrevBtn = prevBtn.cloneNode(true);
        prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
        newPrevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (currentPage > 1) {
            setStoredCurrentPage(currentPage - 1);
            paginateArticles();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      }
      
      if (nextBtn) {
        nextBtn.disabled = currentPage === totalPages;
        // Remove old listeners by cloning
        const newNextBtn = nextBtn.cloneNode(true);
        nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);
        newNextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (currentPage < totalPages) {
            setStoredCurrentPage(currentPage + 1);
            paginateArticles();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      }

      // Hide pagination if only 1 page
      pagination.style.display = totalPages > 1 ? '' : 'none';
    }

    // Initialize page size buttons
    const initializePageSizeButtons = () => {
      const currentSize = getStoredPageSize();
      const buttons = document.querySelectorAll('.articles-per-page-btn');
      
      buttons.forEach((btn) => {
        const size = parseInt(btn.getAttribute('data-size'), 10);
        const isActive = size === currentSize;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.classList.toggle('active', isActive);
      });
    };

    // Setup page size button event listeners
    const setupPageSizeListeners = () => {
      document.querySelectorAll('.articles-per-page-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const newSize = parseInt(btn.getAttribute('data-size'), 10);
          setStoredPageSize(newSize);
          
          // Update button states
          document.querySelectorAll('.articles-per-page-btn').forEach((b) => {
            const size = parseInt(b.getAttribute('data-size'), 10);
            const isActive = size === newSize;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
          
          // Re-paginate with new page size
          paginateArticles();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    };

    // Initialize on page load
    const initializeWhenReady = () => {
      const articles = document.querySelectorAll('.post-list .post-card');
      const pagination = document.querySelector('.pagination');
      const buttons = document.querySelectorAll('.articles-per-page-btn');
      
      if (articles.length > 0 && pagination && buttons.length > 0) {
        initializePageSizeButtons();
        setupPageSizeListeners();
        paginateArticles();
      } else {
        // Retry if elements not ready yet
        setTimeout(initializeWhenReady, 100);
      }
    };

    // Start initialization
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeWhenReady);
    } else {
      initializeWhenReady();
    }
  })();
</script>

<style>
  .articles-per-page-container {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 12px;
    background: var(--surface-2);
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  .articles-per-page-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-soft);
    white-space: nowrap;
  }

  .articles-per-page-control {
    display: flex;
    gap: 4px;
    background: var(--surface);
    padding: 4px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .articles-per-page-btn {
    padding: 6px 14px;
    border: none;
    background: transparent;
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 4px;
    transition: all 150ms ease-out;
    position: relative;

    &:hover:not(.active) {
      background: var(--surface-hover);
      color: var(--text);
    }

    &.active {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 2px 8px rgba(var(--accent-rgb, 59, 130, 246), 0.3);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  }

  @media (max-width: 640px) {
    .articles-per-page-container {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }

    .articles-per-page-btn {
      padding: 5px 12px;
      font-size: 0.85rem;
    }
  }
</style>
