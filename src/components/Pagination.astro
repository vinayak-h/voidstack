---
interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: { current: string; prev?: string; next?: string };
  };
}
const { page } = Astro.props;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---
<nav class="pagination" aria-label="Pagination">
  <button
    class="page-link prev-button"
    data-pagination-action="prev"
    aria-label="Previous page"
  >
    ‹
  </button>
  <div class="page-numbers">
    {pages.map((p) => (
      <button
        class={`page-link ${p === page.currentPage ? 'active' : ''}`}
        data-page={p}
        aria-current={p === page.currentPage ? 'page' : 'false'}
      >
        {p}
      </button>
    ))}
  </div>
  <button
    class="page-link next-button"
    data-pagination-action="next"
    aria-label="Next page"
  >
    ›
  </button>
</nav>

<script is:inline>
  (function () {
    const pagination = document.querySelector('.pagination');
    
    if (!pagination) return;

    function getCurrentPage() {
      try {
        return parseInt(localStorage.getItem('voidstack-current-page') || '1', 10);
      } catch {
        return 1;
      }
    }

    function getPageSize() {
      try {
        const stored = localStorage.getItem('voidstack-articles-per-page');
        return stored ? parseInt(stored, 10) : 5;
      } catch {
        return 5;
      }
    }

    function updatePaginationDisplay() {
      const pageSize = getPageSize();
      const currentPage = getCurrentPage();
      const totalArticles = document.querySelectorAll('.post-list .post-card').length;
      const totalPages = Math.ceil(totalArticles / pageSize);

      // Update page number buttons visibility
      const pageButtons = pagination.querySelectorAll('[data-page]');
      pageButtons.forEach((btn) => {
        const pageNum = parseInt(btn.getAttribute('data-page'), 10);
        const isValid = pageNum <= totalPages;
        btn.style.display = isValid ? '' : 'none';
        btn.classList.toggle('active', pageNum === currentPage && isValid);
        btn.setAttribute('aria-current', pageNum === currentPage && isValid ? 'page' : 'false');
      });

      // Update prev/next button states
      const prevBtn = pagination.querySelector('.prev-button');
      const nextBtn = pagination.querySelector('.next-button');

      if (prevBtn) {
        const canGoPrev = currentPage > 1;
        prevBtn.disabled = !canGoPrev;
        prevBtn.classList.toggle('disabled', !canGoPrev);
      }

      if (nextBtn) {
        const canGoNext = currentPage < totalPages;
        nextBtn.disabled = !canGoNext;
        nextBtn.classList.toggle('disabled', !canGoNext);
      }

      // Hide pagination if only 1 page
      pagination.style.display = totalPages > 1 ? '' : 'none';
    }

    // Handle page button clicks
    pagination.addEventListener('click', (e) => {
      const pageBtn = e.target.closest('[data-page]');
      const navBtn = e.target.closest('[data-pagination-action]');

      if (pageBtn) {
        const newPage = parseInt(pageBtn.getAttribute('data-page'), 10);
        try {
          localStorage.setItem('voidstack-current-page', newPage.toString());
        } catch {}
        // Trigger pagination update
        updatePaginationDisplay();
        document.querySelector('.articles-per-page-btn')?.dispatchEvent(
          new CustomEvent('paginationChanged', { bubbles: true })
        );
      }

      if (navBtn) {
        const currentPage = getCurrentPage();
        const pageSize = getPageSize();
        const totalArticles = document.querySelectorAll('.post-list .post-card').length;
        const totalPages = Math.ceil(totalArticles / pageSize);
        const action = navBtn.getAttribute('data-pagination-action');

        let newPage = currentPage;
        if (action === 'prev' && currentPage > 1) newPage = currentPage - 1;
        if (action === 'next' && currentPage < totalPages) newPage = currentPage + 1;

        if (newPage !== currentPage) {
          try {
            localStorage.setItem('voidstack-current-page', newPage.toString());
          } catch {}
          updatePaginationDisplay();
          document.querySelector('.articles-per-page-btn')?.dispatchEvent(
            new CustomEvent('paginationChanged', { bubbles: true })
          );
        }
      }
    });

    // Update on page load
    updatePaginationDisplay();

    // Listen for page size changes
    document.addEventListener('pagesizechange', updatePaginationDisplay);
  })();
</script>
