---
interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: { current: string; prev?: string; next?: string };
  };
}
const { page } = Astro.props;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---
<nav class="pagination" aria-label="Pagination">
  <button
    class="page-link prev-button"
    data-pagination-action="prev"
    aria-label="Previous page"
  >
    ‹
  </button>
  <div class="page-numbers">
    {pages.map((p) => (
      <button
        class={`page-link ${p === page.currentPage ? 'active' : ''}`}
        data-page={p}
        aria-current={p === page.currentPage ? 'page' : 'false'}
      >
        {p}
      </button>
    ))}
  </div>
  <button
    class="page-link next-button"
    data-pagination-action="next"
    aria-label="Next page"
  >
    ›
  </button>
</nav>

<script is:inline>
  // Pagination component script is now managed by ArticlesPerPage component
  // This script just sets up the basic button structure
</script>
